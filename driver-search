<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Driver Dashboard</title>
<style>
body { font-family: Arial, sans-serif; margin:0; padding:20px; background:#f5f5f5; }
.container { max-width:600px; margin:auto; background:white; padding:22px; border-radius:10px; box-shadow:0 3px 10px rgba(0,0,0,0.12); }
h2 { color:#1b8f2a; text-align:center; margin-bottom:20px; }
input { width:100%; padding:12px; border:2px solid #1b8f2a; border-radius:8px; font-size:16px; margin-bottom:20px; }
button { width:100%; background:#1b8f2a; color:white; padding:14px; border:none; border-radius:8px; font-size:18px; cursor:pointer; }
button:active { background:#166d20; }
.driver-card { display:flex; align-items:center; gap:15px; margin-top:20px; padding:12px; border:1px solid #1b8f2a; border-radius:8px; }
.driver-card img { width:60px; height:60px; border-radius:50%; object-fit:cover; border:2px solid #1b8f2a; }
.msg { margin-top:10px; font-weight:bold; color:red; }
</style>
</head>
<body>

<div class="container">
  <h2>Driver Dashboard</h2>
  
  <label>Search by Number Plate</label>
  <input type="text" id="search_plate" placeholder="Enter number plate">
  <button onclick="searchDriver()">Search</button>
  
  <div id="result"></div>
  <div id="msg" class="msg"></div>
</div>

<script>
async function searchDriver(){
    const plate = document.getElementById("search_plate").value.trim();
    const msg = document.getElementById("msg");
    const result = document.getElementById("result");
    result.innerHTML = "";
    msg.textContent = "";

    if(!plate){
        msg.textContent = "Please enter a number plate.";
        return;
    }

    try{
        const res = await fetch(`https://drivers-backend-4spp.onrender.com/search-driver?number_plate=${encodeURIComponent(plate)}`);
        const data = await res.json();

        if(!data.success){
            msg.textContent = data.error || "Driver not found.";
            return;
        }

        // Display driver info
        const driver = data.driver;
        result.innerHTML = `
            <div class="driver-card">
                <img src="${driver.profile_pic_url || 'https://via.placeholder.com/60'}" alt="Profile">
                <div>
                    <strong>${driver.full_name}</strong><br>
                    ${driver.number_plate}
                </div>
            </div>
        `;

    }catch(e){
        msg.textContent = "Network error. Try again.";
    }
}
</script>

</body>
</html>
